#!/usr/bin/env sh
set -eu

echo "Formatting staged Go files before commit..."

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
found_go_file=false

for file in $staged_files; do
  case "$file" in
    *.go)
      found_go_file=true
      gofmt -w "$file"
      git add "$file"
      ;;
  esac
done

if [ "$found_go_file" = false ]; then
  echo "No staged Go files found."
  exit 0
fi

echo "Pre-commit checks passed."
